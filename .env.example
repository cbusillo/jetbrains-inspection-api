# Key names only. Copy to .env (gitignored) and fill in locally; never commit values.
# Where each credential lives, how to check it and how to rotate it is recorded in the
# private local-information repo's credentials index, not here.

# JetBrains Marketplace upload token for the stable channel.
# CI reads it from the stable-marketplace GitHub environment; locally only
# scripts/publish-stable-artifact.sh and the Gradle publishPlugin task use it.
PUBLISH_TOKEN=

# Optional plugin signing inputs for the Gradle signPlugin task. Unset means unsigned.
CERTIFICATE_CHAIN=
PRIVATE_KEY=
PRIVATE_KEY_PASSWORD=
