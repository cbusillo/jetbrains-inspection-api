{
  "defaultBranch": "main",
  "projectType": "jetbrains-plugin",
  "docs": {
    "overview": "README.md",
    "testing": "TESTING.md",
    "maintenance": "MAINTAINING.md",
    "manualSmoke": "TESTING_INSTRUCTIONS.md",
    "agentSmoke": "TESTING.md#agent-smoke-acceptance",
    "buildManifest": "build.gradle.kts",
    "settings": "settings.gradle.kts",
    "version": "gradle.properties",
    "agentInstructions": "AGENTS.md",
    "direction": "DIRECTION.md",
    "envExample": ".env.example",
    "ciWorkflow": ".github/workflows/ci.yml",
    "releaseWorkflow": ".github/workflows/release.yml",
    "fullBuildReleaseWorkflow": ".github/workflows/agents-release.yml",
    "fullBuildReleaseHelper": "scripts/agents-release.py",
    "commitGate": "scripts/commit-gate.sh",
    "changedFileLanes": "scripts/changed-file-lanes.sh",
    "release": "README.md#releases",
    "releaseCompatibility": "TESTING.md#20262-compatibility-release-gates",
    "releaseScript": "scripts/release.sh"
  },
  "qualityGate": {
    "test": {
      "local": "./gradlew {test_task} --tests '{test_filter}' -x :platformTest",
      "ci": "./scripts/commit-gate.sh --ci",
      "workflowLint": "actionlint .github/workflows/*.yml && uv run scripts/lint-workflow-action-pins.py .github/workflows",
      "shellLint": "shellcheck --severity=warning scripts/*.sh",
      "pythonUvSdk": "JAVA_HOME=\"${JAVA_HOME_21:-$(/usr/libexec/java_home -v 21)}\" ./gradlew -PpythonSdkTestIdePath=/path/to/PyCharm.app pythonUvSdkTest",
      "stableBuild": "JAVA_HOME=\"${JAVA_HOME_21:-$(/usr/libexec/java_home -v 21)}\" ./gradlew buildPlugin verifyPlugin -PinspectionBuild=stable -PpluginVerifierIdes=target && JAVA_HOME=\"${JAVA_HOME_21:-$(/usr/libexec/java_home -v 21)}\" ./gradlew :platformTest -PinspectionBuild=stable --tests '*.StableBuildVerdictPlatformTest'",
      "supportedInspectionExecutor": "JAVA_HOME=\"${JAVA_HOME_21:-$(/usr/libexec/java_home -v 21)}\" ./gradlew :platformTest --tests '*.SupportedInspectionExecutorPlatformTest'",
      "core": "./gradlew :inspection-core:test",
      "mcpServer": "./gradlew :mcp-server-jvm:test",
      "ideRetention": "uv run scripts/test-ide-retention.py",
      "smokeLifecycle": "uv run scripts/test-smoke-lifecycle.py && ./scripts/test-red-lane-smoke-script.sh",
      "desktopClient": "for test in scripts/desktop-client/test_*.py; do uv run \"$test\" || exit 1; done",
      "inspectionBoundaryLint": "uv run scripts/lint-inspection-boundary.py --sources src/main/kotlin --sources src/full/kotlin --sources src/stable/kotlin --boundary src/full/kotlin/com/shiny/inspectionmcp/InspectionBuildEdition.kt --manifest config/plugin-verifier/full-internal-api-allowlist.txt",
      "cancellationCatchLint": "uv run scripts/lint-cancellation-catches.py --sources src/main/kotlin",
      "internalApiManifest": "./scripts/verify-internal-api-allowlist.py --manifest config/plugin-verifier/full-internal-api-allowlist.txt && ./scripts/verify-internal-api-allowlist.py --manifest config/plugin-verifier/stable-internal-api-allowlist.txt",
      "fullBuildRelease": "uv run scripts/test-agents-release.py"
    },
    "build": {
      "buildPlugin": "./gradlew buildPlugin",
      "buildStablePlugin": "./gradlew buildPlugin -PinspectionBuild=stable",
      "verifyPluginStructure": "./gradlew verifyPluginStructure",
      "verifyPluginCompatibility": "./gradlew verifyPlugin",
      "releaseCompatibilityGate": "./scripts/release-compatibility-gate.sh",
      "validateReleaseVersion": "./scripts/validate-release-version.sh --tag vX.Y.Z",
      "verifyStableArtifact": "./scripts/verify-stable-artifact.sh --archive /path/to/jetbrains-inspection-api-X.Y.Z.zip --tag vX.Y.Z --source-sha <40-character-source-sha>",
      "mcpServerJar": "./gradlew :mcp-server-jvm:mcpServerJar"
    },
    "inspection": {
      "scopePreference": "changed_files",
      "prepare": {
        "python": {
          "version": "3.12",
          "moduleName": "inspection-api-scripts",
          "pep723Scripts": [
            "scripts/install-local-plugin.py"
          ]
        }
      },
      "lanes": [
        {
          "id": "fixture-webstorm",
          "ide": "WebStorm",
          "required": false,
          "include": [
            "test-fixtures/inspection-red-lane-webstorm/**"
          ],
          "projectPath": "test-fixtures/inspection-red-lane-webstorm"
        },
        {
          "id": "fixture-pycharm",
          "ide": "PyCharm",
          "required": false,
          "include": [
            "test-fixtures/inspection-red-lane-pycharm/**"
          ],
          "projectPath": "test-fixtures/inspection-red-lane-pycharm"
        },
        {
          "id": "fixture-java",
          "ide": "IntelliJ IDEA",
          "required": false,
          "include": [
            "test-fixtures/inspection-red-lane/**"
          ],
          "projectPath": "test-fixtures/inspection-red-lane"
        },
        {
          "id": "python",
          "ide": "PyCharm",
          "required": true,
          "include": [
            "scripts/*.py",
            "scripts/**/*.py"
          ]
        },
        {
          "id": "jvm",
          "ide": "IntelliJ IDEA",
          "required": true,
          "include": [
            "*",
            "**/*"
          ]
        }
      ]
    },
    "manualSmoke": {
      "automatedIde": "./scripts/test-automated.sh",
      "dogfoodMatrix": "./scripts/dogfood-smoke-matrix.sh",
      "redLaneDogfood": "./scripts/dogfood-red-lane-smoke.sh",
      "redLaneDogfoodIntelliJ": "./scripts/dogfood-red-lane-smoke.sh --product intellij --ide \"IntelliJ IDEA\" --ide-app \"IntelliJ IDEA\" --ide-channel stable --ide-version 2026.2 --timeout-ms 300000 --prepare-timeout-ms 300000",
      "redLaneDogfoodPyCharm": "./scripts/dogfood-red-lane-smoke.sh --product pycharm --ide \"PyCharm\" --ide-app \"PyCharm\" --ide-channel stable --ide-version 2026.2 --timeout-ms 300000 --prepare-timeout-ms 300000",
      "redLaneDogfoodWebStorm": "./scripts/dogfood-red-lane-smoke.sh --product webstorm --ide \"WebStorm\" --ide-app \"WebStorm\" --ide-channel stable --ide-version 2026.2 --timeout-ms 300000 --prepare-timeout-ms 300000"
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "plugin UI or endpoint changes",
      "MCP tool contract changes",
      "build or release workflow changes",
      "manual smoke test flow changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Dependabot Updates",
    "Dependency Graph",
    "Release",
    "Full Build Release"
  ],
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "relatedRepos": [],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "unavailable",
      "dependabotAlerts": "available",
      "securityAdvisories": "available",
      "dependencyGraph": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "commands": [
      {
        "name": "clean local disposable files",
        "command": "./scripts/clean-local.sh",
        "when": "routine",
        "description": "Remove disposable local OS and test-log files while preserving configuration, caches, IDE state, and build output."
      }
    ],
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "cleanup policy changes",
      "release workflow changes",
      "plugin endpoint or MCP contract changes",
      "Java or Gradle version requirements change",
      "direction or agent instructions change",
      "branch protection or rulesets change",
      "merge path changes"
    ]
  },
  "prWorkflow": {
    "mergeMethod": "merge",
    "watchSkill": "babysit-pr",
    "requiredStatusChecks": [
      "commit-gate"
    ],
    "codeScanningMergeProtection": {
      "ruleset": "Require code scanning results",
      "tool": "CodeQL",
      "alertsThreshold": "errors",
      "securityAlertsThreshold": "high_or_higher"
    },
    "codeQualityMergeProtection": {
      "ruleset": "Require code scanning results",
      "severity": "errors"
    }
  },
  "githubSettings": {
    "expected": {
      "deleteBranchOnMerge": true
    }
  },
  "release": {
    "instructions": "README.md#releases",
    "stopBoundaries": "DIRECTION.md#stop-boundaries",
    "stablePublishEnvironment": "stable-marketplace",
    "agentsPublishEnvironment": "agents-marketplace",
    "publicationTrigger": "v* tag push for Stable; successful main push CI for GitHub full builds and the Marketplace agents channel"
  }
}
